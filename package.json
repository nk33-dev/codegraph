{
  "name": "@colbymchenry/codegraph",
  "private": true,
  "version": "1.6.0-personal.7",
  "codegraphDistribution": {
    "channel": "personal",
    "repository": "nk33-dev/codegraph",
    "ref": "personal"
  },
  "description": "Supercharge AI coding agents with semantic code intelligence — surgical context, fewer tool calls, faster answers. 100% local.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nk33-dev/codegraph.git"
  },
  "homepage": "https://github.com/nk33-dev/codegraph#readme",
  "bugs": {
    "url": "https://github.com/nk33-dev/codegraph/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "codegraph": "./dist/bin/codegraph.js"
  },
  "files": [
    "dist",
    "scripts",
    "README.md"
  ],
  "workspaces": [
    "ui"
  ],
  "scripts": {
    "build": "tsc && npm run copy-assets && npm run build:ui && node -e \"require('fs').chmodSync('dist/bin/codegraph.js', 0o755)\" && node scripts/write-build-info.mjs",
    "prepare": "node scripts/prepare-personal.mjs",
    "build:ui": "npm run build --workspace ui && node scripts/check-ui-build.mjs",
    "build:lib": "npm run build:lib --workspace ui",
    "version:sync": "node scripts/sync-ui-version.mjs",
    "check:release-metadata": "node scripts/sync-ui-version.mjs --check",
    "preuninstall": "node dist/bin/uninstall.js",
    "copy-assets": "node -e \"const fs=require('fs');fs.mkdirSync('dist/db',{recursive:true});fs.copyFileSync('src/db/schema.sql','dist/db/schema.sql');fs.mkdirSync('dist/extraction/wasm',{recursive:true});fs.readdirSync('src/extraction/wasm').filter(f=>f.endsWith('.wasm')).forEach(f=>fs.copyFileSync('src/extraction/wasm/'+f,'dist/extraction/wasm/'+f))\"",
    "dev": "tsc --watch",
    "build:kernel": "bash scripts/build-kernel.sh",
    "cli": "npm run build && node dist/bin/codegraph.js",
    "codegraph": "node dist/bin/codegraph.js",
    "verify:personal-install": "npm run build && node scripts/verify-personal-install.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project engine --project ui",
    "test:focused": "vitest run",
    "test:changed": "node scripts/test-changed.mjs",
    "check:quick": "npm run typecheck && npm run test:changed",
    "test:watch": "vitest --project engine --project ui",
    "test:perf": "vitest run --project perf",
    "test:eval": "vitest run __tests__/evaluation/",
    "eval": "npm run build && npx tsx __tests__/evaluation/runner.ts",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "code-intelligence",
    "knowledge-graph",
    "static-analysis"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.3.0",
    "commander": "^14.0.2",
    "fast-string-width": "^3.0.2",
    "fast-wrap-ansi": "^0.2.0",
    "ignore": "^7.0.5",
    "jsonc-parser": "^3.3.1",
    "picomatch": "^4.0.3",
    "sisteransi": "^1.0.5",
    "tree-sitter-wasms": "^0.1.11",
    "web-tree-sitter": "^0.25.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.19.30",
    "@types/picomatch": "^4.0.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.0.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.0.0 <25.0.0"
  }
}
